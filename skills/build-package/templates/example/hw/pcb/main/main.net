(export (version "E")
  (nets
    (net (code "1") (name "VBAT")
      (node (ref "U1") (pin "1") (pinfunction "VDD") (pintype "power_in"))
      (node (ref "C1") (pin "1") (pintype "passive")))
    (net (code "2") (name "/LED_K")
      (node (ref "U1") (pin "12") (pinfunction "P0.12") (pintype "bidirectional"))
      (node (ref "R1") (pin "2") (pintype "passive")))
    (net (code "3") (name "GND")
      (node (ref "U1") (pin "33") (pinfunction "VSS") (pintype "power_in")))))
